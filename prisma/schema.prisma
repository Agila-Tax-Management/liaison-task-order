   generator client {
     provider = "prisma-client-js"
   }

   datasource db {
     provider = "sqlite"
     url      = env("DATABASE_URL")
   }

   model TaskOrder {
     id              Int      @id @default(autoincrement())
     taskOrderNumber String   @unique
     clientName      String
     location        String
     taskName        String
     todo            String
     requestedBy     String
     dateRequested   DateTime
     taskStatus      String?
     update          String?
     whatsNext       String?
     clickupUpdated  Boolean  @default(false)
     createdAt       DateTime @default(now())
     updatedAt       DateTime @updatedAt
   }